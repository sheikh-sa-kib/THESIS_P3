<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="..\maps\midtown_manhattan.net.xml"/>
        <route-files value="..\routes\midtown_manhattan.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>
    <processing>
        <default.speeddev value="0.1"/>
        <ignore-route-errors value="true"/>
    </processing>
    <report>
        <no-step-log value="true"/>
        <duration-log.disable value="true"/>
        <no-warnings value="true"/>
        <verbose value="false"/>
    </report>
</configuration>
